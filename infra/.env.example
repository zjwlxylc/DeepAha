# Copy to infra/.env and fill on the actual host. Never commit the completed file.
POSTGRES_DB=deepaha
POSTGRES_USER=deepaha
POSTGRES_PASSWORD=
# Percent-encode password special characters in the SQLAlchemy URL.
DEEPAHA_DATABASE_URL=
DEEPAHA_MODE=production
DEEPAHA_SECURE_COOKIE=1
# Include loopback for the container health probe; list real hostnames, no wildcard.
DEEPAHA_ALLOWED_HOSTS=deepaha.com,www.deepaha.com,127.0.0.1,localhost
DEEPAHA_ALLOWED_ORIGINS=https://deepaha.com,https://www.deepaha.com
# Keep closed until the owner explicitly authorizes public access.
DEEPAHA_PUBLIC_CATALOG=0
DEEPAHA_ALLOW_REGISTRATION=0
DEEPAHA_WITH_WMA=0
DEEPAHA_WMA_ENABLED=0
DEEPAHA_WMA_AGENT_ID=
DEEPAHA_WMA_API_KEY=
DEEPAHA_WMA_SOURCE_APP=deepaha-dail
