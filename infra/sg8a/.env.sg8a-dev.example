POSTGRES_DB=deepaha_dev
POSTGRES_USER=deepaha_dev
POSTGRES_PASSWORD=local-dev-only-change-me
DEEPAHA_DATABASE_URL=postgresql+psycopg://deepaha_dev:local-dev-only-change-me@postgres:5432/deepaha_dev
# For a browser over local HTTP, run the container in local mode instead of claiming production.
DEEPAHA_MODE=local
DEEPAHA_SECURE_COOKIE=0
DEEPAHA_ALLOWED_HOSTS=localhost,127.0.0.1
DEEPAHA_ALLOWED_ORIGINS=http://127.0.0.1:18000,http://localhost:18000
DEEPAHA_PUBLIC_CATALOG=0
DEEPAHA_ALLOW_REGISTRATION=0
DEEPAHA_WMA_ENABLED=0
