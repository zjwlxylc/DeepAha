# DeepAha SG8-A production environment. Copy to /etc/deepaha/production.env.
# chmod 640, owner root:deepaha. Never commit the completed file.
DEEPAHA_MODE=production
DEEPAHA_PORT=8000
DEEPAHA_DATA_DIR=/var/lib/deepaha/production
DEEPAHA_DATABASE_URL=postgresql+psycopg://deepaha_prod:URL_ENCODED_PASSWORD@127.0.0.1:5432/deepaha_prod
DEEPAHA_SECURE_COOKIE=1
DEEPAHA_ALLOWED_HOSTS=deepaha.com,www.deepaha.com,127.0.0.1,localhost
DEEPAHA_ALLOWED_ORIGINS=https://deepaha.com,https://www.deepaha.com
# Public opportunity browsing may be enabled for Public Beta; self-registration stays closed.
DEEPAHA_PUBLIC_CATALOG=1
DEEPAHA_ALLOW_REGISTRATION=0
# Enable only after the published WMA binding has passed a server-side smoke check.
DEEPAHA_WMA_ENABLED=0
DEEPAHA_WMA_AGENT_ID=
DEEPAHA_WMA_API_KEY=
DEEPAHA_WMA_SOURCE_APP=deepaha-dail
# Host PostgreSQL tools use these without putting the password in argv.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=deepaha_prod
PGUSER=deepaha_prod
PGPASSWORD=CHANGE_ME
