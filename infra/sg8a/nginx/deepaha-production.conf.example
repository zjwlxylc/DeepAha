# Include inside nginx http{} (Debian/Ubuntu sites-enabled is already inside http{}).
# Merge with the existing deepaha.com TLS server; do not overwrite blindly.
limit_req_zone $binary_remote_addr zone=deepaha_auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=deepaha_api:10m rate=30r/s;

server {
    listen 443 ssl http2;
    server_name deepaha.com www.deepaha.com;
    ssl_certificate /etc/letsencrypt/live/deepaha.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/deepaha.com/privkey.pem;
    server_tokens off;
    add_header Strict-Transport-Security "max-age=31536000" always;

    client_max_body_size 33m;
    location = /api/auth/login {
        limit_req zone=deepaha_auth burst=10 nodelay;
        proxy_pass http://127.0.0.1:8000;
        include /etc/nginx/proxy_params;
        proxy_set_header X-Forwarded-Proto https;
    }
    location = /api/auth/register {
        limit_req zone=deepaha_auth burst=5 nodelay;
        proxy_pass http://127.0.0.1:8000;
        include /etc/nginx/proxy_params;
        proxy_set_header X-Forwarded-Proto https;
    }
    location = /api/manage/scout/previews {
        client_max_body_size 101m;
        limit_req zone=deepaha_api burst=20 nodelay;
        proxy_pass http://127.0.0.1:8000;
        include /etc/nginx/proxy_params;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 180s;
    }
    location /api/ {
        limit_req zone=deepaha_api burst=60 nodelay;
        proxy_pass http://127.0.0.1:8000;
        include /etc/nginx/proxy_params;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
    }
    location / {
        proxy_pass http://127.0.0.1:8000;
        include /etc/nginx/proxy_params;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
    }
}
server {
    listen 80;
    server_name deepaha.com www.deepaha.com;
    return 301 https://$host$request_uri;
}
