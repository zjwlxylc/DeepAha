# DeepAha SG8-A staging environment. Copy to /etc/deepaha/staging.env.
DEEPAHA_MODE=production
DEEPAHA_PORT=8100
DEEPAHA_DATA_DIR=/var/lib/deepaha/staging
DEEPAHA_DATABASE_URL=postgresql+psycopg://deepaha_staging:URL_ENCODED_PASSWORD@127.0.0.1:5432/deepaha_staging
DEEPAHA_SECURE_COOKIE=1
DEEPAHA_ALLOWED_HOSTS=staging.deepaha.com,127.0.0.1,localhost
DEEPAHA_ALLOWED_ORIGINS=https://staging.deepaha.com
DEEPAHA_PUBLIC_CATALOG=0
DEEPAHA_ALLOW_REGISTRATION=0
DEEPAHA_WMA_ENABLED=0
DEEPAHA_WMA_AGENT_ID=
DEEPAHA_WMA_API_KEY=
DEEPAHA_WMA_SOURCE_APP=deepaha-dail
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=deepaha_staging
PGUSER=deepaha_staging
PGPASSWORD=CHANGE_ME

# Optional R3 WeChat share signing: server-side only, never expose in HTML.
DEEPAHA_WECHAT_APP_ID=
DEEPAHA_WECHAT_APP_SECRET=
