{
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "format": "uuid",
      "title": "Artifact Id",
      "type": "string"
    },
    "byte_size": {
      "exclusiveMinimum": 0,
      "title": "Byte Size",
      "type": "integer"
    },
    "collector_version": {
      "minLength": 1,
      "title": "Collector Version",
      "type": "string"
    },
    "content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "http_status": {
      "anyOf": [
        {
          "maximum": 599,
          "minimum": 100,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Http Status"
    },
    "media_type": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Media Type"
    },
    "metadata_schema_version": {
      "minLength": 1,
      "title": "Metadata Schema Version",
      "type": "string"
    },
    "requested_url": {
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "title": "Requested Url",
      "type": "string"
    },
    "resolved_url": {
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "title": "Resolved Url",
      "type": "string"
    },
    "retrieved_at": {
      "format": "date-time",
      "title": "Retrieved At",
      "type": "string"
    },
    "source_id": {
      "format": "uuid",
      "title": "Source Id",
      "type": "string"
    },
    "storage_uri": {
      "pattern": "^s3://[a-z0-9][a-z0-9.-]*/[^\\s]+$",
      "title": "Storage Uri",
      "type": "string"
    }
  },
  "required": [
    "artifact_id",
    "source_id",
    "requested_url",
    "resolved_url",
    "retrieved_at",
    "http_status",
    "media_type",
    "content_sha256",
    "storage_uri",
    "byte_size",
    "collector_version",
    "metadata_schema_version"
  ],
  "title": "RawArtifactSchema",
  "type": "object"
}
