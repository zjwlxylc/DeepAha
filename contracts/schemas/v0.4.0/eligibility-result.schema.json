{
  "$defs": {
    "EligibilityStatus": {
      "enum": [
        "ELIGIBLE",
        "LIKELY_ELIGIBLE",
        "UNCERTAIN",
        "INELIGIBLE"
      ],
      "title": "EligibilityStatus",
      "type": "string"
    },
    "RuleEvaluationSchemaV04": {
      "additionalProperties": false,
      "properties": {
        "deterministic": {
          "title": "Deterministic",
          "type": "boolean"
        },
        "evidence_ref_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Evidence Ref Ids",
          "type": "array"
        },
        "missing_fields": {
          "items": {
            "$ref": "#/$defs/RuleField"
          },
          "title": "Missing Fields",
          "type": "array"
        },
        "official_evidence": {
          "title": "Official Evidence",
          "type": "boolean"
        },
        "outcome": {
          "$ref": "#/$defs/RuleOutcome"
        },
        "reason_code": {
          "minLength": 1,
          "title": "Reason Code",
          "type": "string"
        },
        "rule_id": {
          "format": "uuid",
          "title": "Rule Id",
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "outcome",
        "deterministic",
        "official_evidence",
        "reason_code",
        "evidence_ref_ids",
        "missing_fields"
      ],
      "title": "RuleEvaluationSchemaV04",
      "type": "object"
    },
    "RuleField": {
      "enum": [
        "education_level",
        "major_code",
        "graduation_year",
        "student_status",
        "birth_date",
        "hukou_region",
        "residence_region",
        "target_regions",
        "certificates"
      ],
      "title": "RuleField",
      "type": "string"
    },
    "RuleOutcome": {
      "enum": [
        "SATISFIED",
        "CONFLICT",
        "UNKNOWN"
      ],
      "title": "RuleOutcome",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "conflict_rule_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Conflict Rule Ids",
      "type": "array"
    },
    "engine_version": {
      "minLength": 1,
      "title": "Engine Version",
      "type": "string"
    },
    "evaluated_at": {
      "format": "date-time",
      "title": "Evaluated At",
      "type": "string"
    },
    "missing_fields": {
      "items": {
        "$ref": "#/$defs/RuleField"
      },
      "title": "Missing Fields",
      "type": "array"
    },
    "result_id": {
      "format": "uuid",
      "title": "Result Id",
      "type": "string"
    },
    "review_reasons": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Review Reasons",
      "type": "array"
    },
    "rule_evaluations": {
      "items": {
        "$ref": "#/$defs/RuleEvaluationSchemaV04"
      },
      "minItems": 1,
      "title": "Rule Evaluations",
      "type": "array"
    },
    "satisfied_rule_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Satisfied Rule Ids",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/EligibilityStatus"
    },
    "unknown_rule_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Unknown Rule Ids",
      "type": "array"
    }
  },
  "required": [
    "result_id",
    "status",
    "rule_evaluations",
    "satisfied_rule_ids",
    "conflict_rule_ids",
    "unknown_rule_ids",
    "missing_fields",
    "review_reasons",
    "evaluated_at",
    "engine_version"
  ],
  "title": "EligibilityResultSchemaV04",
  "type": "object"
}
