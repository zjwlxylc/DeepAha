      "title": "Collector Name",
      "type": "string"
    },
    "collector_version": {
      "minLength": 1,
      "title": "Collector Version",
      "type": "string"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "endpoint_id": {
      "format": "uuid",
      "title": "Endpoint Id",
      "type": "string"
    },
    "error_code": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
