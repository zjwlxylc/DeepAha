    "source_bundle_revision_id",
    "target_scope",
    "opportunity_id",
    "opportunity_version",
    "opportunity_unit_id",
    "opportunity_unit_version_id",
    "input_block_ids",
    "input_block_hashes",
    "data_classification_version",
    "minimizer_version",
    "redactor_version",
    "source_policy_snapshot_id",
    "source_policy_snapshot_hash",
    "provider_policy_snapshot_id",
    "provider_policy_snapshot_hash",
    "provider",
    "provider_region",
    "original_input_hash",
    "actual_payload_hash",
    "decision",
    "actor_type",
    "actor_identity",
    "reason_codes",
    "created_at",
    "expires_at"
