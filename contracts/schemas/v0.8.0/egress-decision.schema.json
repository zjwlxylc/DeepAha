          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Actor Identity"
    },
    "actor_type": {
      "enum": [
        "SYSTEM",
        "HUMAN"
      ],
      "title": "Actor Type",
      "type": "string"
    },
    "actual_payload_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Actual Payload Hash"
    },
    "created_at": {
      "format": "date-time",
