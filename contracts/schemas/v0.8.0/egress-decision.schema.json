      "type": "string"
    },
    "provider_policy_snapshot_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Provider Policy Snapshot Id",
      "type": "string"
    },
    "provider_region": {
      "maxLength": 64,
      "minLength": 1,
