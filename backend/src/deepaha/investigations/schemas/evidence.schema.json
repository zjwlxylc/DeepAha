{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EvidenceBundle",
  "type": "object",
  "required": ["artifacts", "entities", "facts_flat"],
  "properties": {
    "artifacts": {
      "type": "array",
      "description": "全部接触到的官方材料元数据",
      "items": {"type": "object"}
    },
    "entities": {
      "type": "array",
      "description": "实体树（公告/单位/岗位/赛道）",
      "items": {
        "type": "object",
        "required": ["id", "kind", "name"],
        "properties": {
          "id": {"type": "string"},
          "parent_id": {"type": ["string", "null"]},
          "kind": {"type": "string", "enum": ["announcement", "unit", "position", "track", "other"]},
          "name": {"type": "string"},
          "code": {"type": ["string", "null"]},
          "org": {"type": ["string", "null"]}
        }
      }
    },
    "facts_flat": {
      "type": "array",
      "description": "扁平化事实列表，便于程序校验",
      "items": {"type": "object"}
    }
  }
}
